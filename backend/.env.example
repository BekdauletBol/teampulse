# Copy to .env for local development. On Render these come from the dashboard / render.yaml.

# "development" (default) allows the built-in dev secret. Anything else requires SECRET_KEY.
APP_ENV=development

# SQLite for local dev. Render injects a postgres:// URL (postgresql:// also works).
DATABASE_URL=sqlite:///./teampulse.db

# Signs JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Where the React app is served; used for invite links and CORS.
FRONTEND_URL=http://localhost:5173

# Optional
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
